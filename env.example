# FCM 配置（需要从 Firebase Console 获取）
VITE_FCM_VAPID_KEY=your_vapid_key_here

# Gemini AI 配置（用于 AI 识茄功能）
# 获取 API Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_server_only_gemini_key

# Google Custom Search API 配置（用于图片搜索）
# 获取 API Key: https://console.cloud.google.com/apis/credentials
# 创建自定义搜索引擎: https://programmablesearchengine.google.com/controlpanel/create
GOOGLE_SEARCH_API_KEY=your_server_only_google_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here
# Netlify Functions only; never prefix these secrets with VITE_
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
ADMIN_UIDS=comma_separated_trusted_firebase_auth_uids
# FIREBASE_SERVICE_ACCOUNT must be configured securely in Netlify Functions.
